{
  "name": "solariskit",
  "version": "1.9.0",
  "description": "React wallet connection UI for EVM chains and Solana",
  "keywords": [
    "ethereum",
    "evm",
    "react",
    "solana",
    "viem",
    "wagmi",
    "wallet",
    "wallet-connect",
    "web3"
  ],
  "homepage": "https://gh.akshatmittal.com/solaris/",
  "bugs": "https://github.com/akshatmittal/solaris/issues",
  "license": "MIT",
  "author": "Akshat Mittal",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/akshatmittal/solaris.git",
    "directory": "packages/solariskit"
  },
  "files": [
    "dist"
  ],
  "type": "module",
  "sideEffects": [
    "**/*.css"
  ],
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": "./dist/index.js",
    "./styles.css": "./dist/index.css",
    "./solana": {
      "types": "./dist/solana/index.d.ts",
      "import": "./dist/solana/index.js"
    },
    "./solana/styles.css": "./dist/index.css",
    "./wallets": "./dist/wallets/walletConnectors/index.js",
    "./components": "./dist/components/index.js"
  },
  "scripts": {
    "build": "tsdown",
    "build:watch": "tsdown --watch",
    "clean": "rm -rf .turbo dist node_modules",
    "dev": "pnpm run build:watch",
    "prepack": "pnpm run build",
    "typecheck": "pnpm tsc --noEmit"
  },
  "dependencies": {
    "@akshatmittal/polycons": "workspace:*",
    "@stylexjs/stylex": "0.19.1",
    "qr": "0.7.2",
    "react-remove-scroll": "2.7.2"
  },
  "devDependencies": {
    "@base-org/account": "^2.5.7",
    "@safe-global/safe-apps-provider": "^0.18.6",
    "@safe-global/safe-apps-sdk": "^9.1.0",
    "@solana/connector": "0.3.0",
    "@solana/kit": "^8.6.0",
    "@stylexjs/rollup-plugin": "0.19.1",
    "@tanstack/react-query": "catalog:",
    "@types/node": "catalog:",
    "@types/react": "catalog:",
    "@types/react-dom": "catalog:",
    "@walletconnect/ethereum-provider": "^2.26.0",
    "@workspace/typescript-config": "workspace:*",
    "react": "catalog:",
    "react-dom": "catalog:",
    "tsdown": "catalog:",
    "typescript": "catalog:",
    "viem": "catalog:",
    "wagmi": "catalog:"
  },
  "peerDependencies": {
    "@base-org/account": "^2.5.1",
    "@safe-global/safe-apps-provider": "^0.18.6",
    "@safe-global/safe-apps-sdk": "^9.1.0",
    "@solana/connector": "^0.3.0",
    "@solana/kit": "^8.6.0",
    "@walletconnect/ethereum-provider": "^2.21.1",
    "react": "^18 || ^19",
    "react-dom": "^18 || ^19",
    "viem": "^2.0.0",
    "wagmi": "^3.0.0"
  },
  "peerDependenciesMeta": {
    "@base-org/account": {
      "optional": true
    },
    "@safe-global/safe-apps-provider": {
      "optional": true
    },
    "@safe-global/safe-apps-sdk": {
      "optional": true
    },
    "@solana/connector": {
      "optional": true
    },
    "@solana/kit": {
      "optional": true
    },
    "@walletconnect/ethereum-provider": {
      "optional": true
    }
  },
  "engines": {
    "node": ">=24"
  }
}
